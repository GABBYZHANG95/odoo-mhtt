<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer contracts (#53): no longer readable by everybody -->
    <record id="aiis_customer_contract.customer_contract_rule_read_all" model="ir.rule">
        <field name="name">Customer Contract: CEO, CFO and sales managers read all</field>
        <field name="groups" eval="[(6, 0, [ref('aiis_procurement_request.group_po_approver_ceo'),
                                            ref('aiis_sales_expense.group_sales_budget_manager'),
                                            ref('sales_team.group_sale_manager')])]"/>
    </record>
    <record id="customer_contract_rule_read_own" model="ir.rule">
        <field name="name">Customer Contract: read what I sell, approve or head</field>
        <field name="model_id" ref="aiis_customer_contract.model_customer_contract"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', '|',
            ('salesperson_id.user_id', '=', user.id),
            ('manager_id.user_id', '=', user.id),
            ('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
