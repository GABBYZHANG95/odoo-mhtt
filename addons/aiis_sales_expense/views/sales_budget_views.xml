<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aiis_sales_budget_tree" model="ir.ui.view">
        <field name="name">aiis.sales.budget.tree</field>
        <field name="model">aiis.sales.budget</field>
        <field name="arch" type="xml">
            <tree string="Sales Expense Budgets" editable="bottom">
                <field name="department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="used" sum="Total"/>
                <field name="remaining" sum="Total" decoration-danger="remaining &lt; 0"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="action_aiis_sales_budget" model="ir.actions.act_window">
        <field name="name">Sales Expense Budgets</field>
        <field name="res_model">aiis.sales.budget</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No budgets yet</p>
            <p>Set each department's budget for sales trips, client entertainment and gifts, per year or quarter.
               Approvers see it on every request and reimbursement.</p>
        </field>
    </record>

</odoo>
