<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aiis_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">aiis.approval.reject.wizard.form</field>
        <field name="model">aiis.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject">
                <p>The document goes back to its submitter, who can change it and submit it again.</p>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="reason" placeholder="Why is it rejected?"/>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_aiis_approval_reassign_wizard_form" model="ir.ui.view">
        <field name="name">aiis.approval.reassign.wizard.form</field>
        <field name="model">aiis.approval.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Reassign Approval">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="current_user_id"/>
                    <field name="user_id"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reassign" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
