<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A confirmed PO doubles as the purchase contract: payment terms and
         delivery date up front, signatures for both parties at the end. -->
    <template id="report_purchaseorder_document_aiis" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.payment_term_id" class="col-3 bm-2" name="informations_payment_term">
                <strong>Payment Terms:</strong>
                <p t-field="o.payment_term_id" class="m-0"/>
            </div>
            <div t-if="o.date_planned" class="col-3 bm-2" name="informations_date_planned">
                <strong>Expected Delivery:</strong>
                <p t-field="o.date_planned" t-options='{"widget": "date"}' class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//p[@t-field='o.notes']" position="after">
            <t t-if="o.state in ('purchase', 'done')">
                <t t-set="left_title" t-value="'For and on behalf of %s (Buyer)' % o.company_id.name"/>
                <t t-set="right_title" t-value="'Accepted by %s (Vendor)' % o.partner_id.commercial_partner_id.name"/>
                <t t-set="right_signature" t-value="False"/>
                <t t-call="aiis_documents.signature_block"/>
            </t>
        </xpath>
    </template>

</odoo>
