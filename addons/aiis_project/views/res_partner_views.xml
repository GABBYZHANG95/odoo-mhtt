<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_aiis_customer_code" model="ir.ui.view">
        <field name="name">res.partner.form.aiis.customer.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']/field[@name='user_id']" position="after">
                <field name="aiis_customer_code" placeholder="e.g. STC" invisible="parent_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_aiis_customer_code" model="ir.ui.view">
        <field name="name">res.partner.tree.aiis.customer.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="aiis_customer_code" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_res_partner_filter_aiis_customer_code" model="ir.ui.view">
        <field name="name">res.partner.search.aiis.customer.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="aiis_customer_code"/>
            </field>
        </field>
    </record>

</odoo>
