<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_procurement_request_create_po_wizard_form" model="ir.ui.view">
        <field name="name">procurement.request.create.po.wizard.form</field>
        <field name="model">procurement.request.create.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Order">
                <group>
                    <field name="request_id" invisible="1"/>
                    <!-- supplier mode: a vendor created right here is flagged as a
                         vendor, so it shows up in this list next time -->
                    <field name="partner_id" context="{'res_partner_search_mode': 'supplier'}"/>
                    <field name="has_new_products" invisible="1"/>
                    <field name="categ_id" invisible="not has_new_products" required="has_new_products"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Create Purchase Order" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
