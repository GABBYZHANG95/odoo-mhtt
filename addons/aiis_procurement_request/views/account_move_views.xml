<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_bill_terms" model="ir.ui.view">
        <field name="name">account.move.purchase.commercial.terms</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="aiis_purchase_bill" invisible="1"/>
                <button name="action_return_to_procurement" string="Return to Procurement"
                        type="object" invisible="not aiis_purchase_bill or state != 'draft'"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="aiis_purchase_order_id" invisible="not aiis_purchase_bill" readonly="1" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-info" role="status" invisible="not aiis_purchase_bill or not workflow_hint">
                    <i class="fa fa-info-circle me-1"/><field name="workflow_hint" nolabel="1" class="d-inline"/>
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-info" invisible="not aiis_purchase_bill or state != 'draft'">
                    Commercial terms follow the approved PO. For a price, quantity or tax difference, use Return to Procurement.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly" add="aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="readonly" add="aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="readonly" add="aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_cash_rounding_id']" position="attributes">
                <attribute name="readonly" add="aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="readonly" add="aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="readonly" add="parent.aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly" add="parent.aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="attributes">
                <attribute name="readonly" add="parent.aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="attributes">
                <attribute name="readonly" add="parent.aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="attributes">
                <attribute name="readonly" add="parent.aiis_purchase_bill" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']" position="attributes">
                <attribute name="readonly" add="parent.aiis_purchase_bill" separator=" or "/>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_bill_return_form" model="ir.ui.view">
        <field name="name">aiis.purchase.bill.return.form</field>
        <field name="model">aiis.purchase.bill.return</field>
        <field name="arch" type="xml">
            <form string="Return to Procurement">
                <group>
                    <field name="bill_id" readonly="1"/>
                    <field name="reason" placeholder="Explain the price, quantity or other commercial difference."/>
                </group>
                <p>The draft bill will be cancelled. Procurement must revise the PO and obtain approval again before a new bill can be paid.</p>
                <footer>
                    <button name="action_return" type="object" string="Return to Procurement" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
