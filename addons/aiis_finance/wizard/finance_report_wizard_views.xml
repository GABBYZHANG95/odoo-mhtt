<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_report_wizard_form" model="ir.ui.view">
        <field name="name">aiis.finance.report.wizard.form</field>
        <field name="model">aiis.finance.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="text-muted mb-2">Accrual basis · SAR · Actual figures only</div>
                <group>
                    <group>
                        <field name="report" invisible="1"/>
                        <field name="fiscal_year" options="{'format': false}"/>
                        <field name="cutoff_date"/>
                        <field name="columns" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group invisible="report != 'pl'">
                        <field name="project_id" options="{'no_create': True}"/>
                        <field name="department_id" options="{'no_create': True}"/>
                    </group>
                    <field name="company_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_open" type="object" string="Show Report" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_profit_loss" model="ir.actions.act_window">
        <field name="name">Profit &amp; Loss</field>
        <field name="res_model">aiis.finance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report': 'pl'}</field>
    </record>

    <record id="action_report_balance_sheet" model="ir.actions.act_window">
        <field name="name">Balance Sheet</field>
        <field name="res_model">aiis.finance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report': 'bs'}</field>
    </record>
</odoo>
