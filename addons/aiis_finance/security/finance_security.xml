<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bank entry and reconciliation are operational CFO duties. This
         separate group does not grant bank writes to the read-only board
         or change the permissions of other billing administrators. -->
    <record id="group_finance_bank_operator" model="res.groups">
        <field name="name">Finance: Bank Reconciliation (CFO)</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <!-- Finance board (design doc 6.8.6): Overview and Reports for the
         CFO, CEO and Chairman only. Reading the books needs read access to
         accounting. -->
    <record id="group_finance_board" model="res.groups">
        <field name="name">Finance Board (CFO, CEO, Chairman)</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Finance › Overview and Reports: P&amp;L, Balance Sheet, Receivables &amp; Payables, Cash Flow, Checks, and their exports.</field>
    </record>

    <!-- Personnel costs: HR enters them; HR, CFO, CEO and Chairman see them; employees never do -->
    <record id="rule_personnel_cost_company" model="ir.rule">
        <field name="name">Personnel costs: own companies</field>
        <field name="model_id" ref="model_aiis_personnel_cost"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_account_mapping_company" model="ir.rule">
        <field name="name">Expense account mapping: own companies</field>
        <field name="model_id" ref="model_aiis_account_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
