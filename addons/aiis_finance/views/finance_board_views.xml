<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_finance_overview" model="ir.actions.client">
        <field name="name">Finance Overview</field>
        <field name="tag">aiis_finance_board</field>
        <field name="params" eval="{'page': 'overview'}"/>
    </record>

    <record id="action_finance_cash_flow" model="ir.actions.client">
        <field name="name">Cash Flow</field>
        <field name="tag">aiis_finance_board</field>
        <field name="params" eval="{'page': 'cash_flow'}"/>
    </record>

    <record id="action_finance_checks" model="ir.actions.client">
        <field name="name">Checks</field>
        <field name="tag">aiis_finance_board</field>
        <field name="params" eval="{'page': 'checks'}"/>
    </record>

    <!-- Receivables & Payables: the OCA aged balance, our intervals and accounts -->
    <record id="action_aged_balance" model="ir.actions.act_window">
        <field name="name">Aged Receivables &amp; Payables</field>
        <field name="res_model">aged.partner.balance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context" eval="{'default_age_partner_config_id': ref('age_configuration')}"/>
    </record>

    <record id="action_partner_statements" model="ir.actions.act_window">
        <field name="name">Partner Statements</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|', ('customer_rank', '>', 0), ('supplier_rank', '>', 0)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No customers or vendors yet</p>
            <p>Select partners, then Action › Partner Statement to print an activity or outstanding statement.</p>
        </field>
    </record>
</odoo>
