<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_personnel_cost_list" model="ir.ui.view">
        <field name="name">aiis.personnel.cost.list</field>
        <field name="model">aiis.personnel.cost</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="type_id"/>
                <field name="description" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_personnel_cost_form" model="ir.ui.view">
        <field name="name">aiis.personnel.cost.form</field>
        <field name="model">aiis.personnel.cost</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary"
                            invisible="state != 'draft'" groups="hr.group_hr_user"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'posted'" groups="hr.group_hr_user"
                            confirm="Cancel this personnel cost and its journal entry?"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'" groups="hr.group_hr_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="type_id" readonly="state != 'draft'"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="move_id" invisible="not move_id" groups="account.group_account_readonly"/>
                            <field name="contract_id" invisible="not contract_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_personnel_cost_search" model="ir.ui.view">
        <field name="name">aiis.personnel.cost.search</field>
        <field name="model">aiis.personnel.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="type_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_type" string="Cost Type" context="{'group_by': 'type_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_personnel_cost" model="ir.actions.act_window">
        <field name="name">Personnel Costs</field>
        <field name="res_model">aiis.personnel.cost</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="context">{'search_default_group_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a personnel cost</p>
            <p>Salaries are recorded every month from the employee contracts. Enter visa and Iqama
               fees, insurance, GOSI and other employee costs here; posting books them to the
               department's Personnel cost. Employees cannot see these.</p>
        </field>
    </record>

    <record id="view_personnel_cost_type_list" model="ir.ui.view">
        <field name="name">aiis.personnel.cost.type.list</field>
        <field name="model">aiis.personnel.cost.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_personnel_cost_type" model="ir.actions.act_window">
        <field name="name">Personnel Cost Types</field>
        <field name="res_model">aiis.personnel.cost.type</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
