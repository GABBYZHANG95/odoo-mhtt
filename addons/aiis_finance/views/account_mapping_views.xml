<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_mapping_list" model="ir.ui.view">
        <field name="name">aiis.account.mapping.list</field>
        <field name="model">aiis.account.mapping</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="categ_id"/>
                <field name="function" placeholder="Any department"/>
                <field name="account_id"/>
                <field name="company_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_account_mapping_search" model="ir.ui.view">
        <field name="name">aiis.account.mapping.search</field>
        <field name="model">aiis.account.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="categ_id"/>
                <field name="account_id"/>
                <filter name="group_categ" string="Nature" context="{'group_by': 'categ_id'}"/>
                <filter name="group_function" string="Function" context="{'group_by': 'function'}"/>
            </search>
        </field>
    </record>

    <record id="action_account_mapping" model="ir.actions.act_window">
        <field name="name">Expense Account Mapping</field>
        <field name="res_model">aiis.account.mapping</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map what is bought to an expense account</p>
            <p>A cost from a purchase request or an expense report goes to the account of its
               product category (nature) for the requester's department function (G&amp;A, R&amp;D, Sales).
               Project purchases go to Cost of revenue whatever this says.</p>
        </field>
    </record>

    <record id="product_category_form_view_aiis_finance" model="ir.ui.view">
        <field name="name">product.category.form.aiis.finance</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Booking (MHTT)" groups="account.group_account_manager">
                    <field name="aiis_asset_account_id"/>
                    <field name="aiis_mapping_ids" nolabel="1" colspan="2" context="{'default_categ_id': id}">
                        <tree editable="bottom">
                            <field name="function" placeholder="Any department"/>
                            <field name="account_id"/>
                            <field name="company_id" column_invisible="True"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
