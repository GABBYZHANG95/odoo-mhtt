<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Profit & Loss, design doc 6.1, 6.2 and 6.8.3 (40 lines).
         Generated from the report lines of account.account (aiis_report_line);
         see models/account_account.py. -->
    <record id="mis_report_profit_loss" model="mis.report">
        <field name="name">MHTT Profit &amp; Loss</field>
        <field name="description">Accrual basis - SAR - actual figures only</field>
        <field name="style_id" ref="mis_style_base"/>
    </record>
    <record id="mis_report_profit_loss_kpi_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss"/>
        <field name="sequence">10</field>
        <field name="name">revenue</field>
        <field name="description">Recognized revenue</field>
        <field name="expression">-balp[('aiis_report_line', '=', 'revenue')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_style_category"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_style_account"/>
    </record>
    <record id="mis_report_profit_loss_kpi_cost_of_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_profit_loss"/>
        <field name="sequence">20</field>
        <field name="name">cost_of_revenue</field>
        <field name="description">Cost of revenue</field>
        <field name="expression">balp[('aiis_report_line', '=', 'cost_of_revenue')]</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_style_category"/>
        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_style_account"/>
    </record>
