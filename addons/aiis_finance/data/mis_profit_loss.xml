        <field name="report_id" ref="mis_report_profit_loss"/>
        <field name="sequence">30</field>
        <field name="name">gross_profit</field>
        <field name="description">Gross profit</field>
        <field name="expression">revenue - cost_of_revenue</field>
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="style_id" ref="mis_style_total"/>
        <field name="auto_expand_accounts" eval="False"/>
        <field name="auto_expand_accounts_style_id" ref="mis_style_account"/>
