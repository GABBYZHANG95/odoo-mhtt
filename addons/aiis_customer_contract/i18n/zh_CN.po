#. module: aiis_customer_contract
#. odoo-python
#: code:addons/aiis_customer_contract/models/customer_contract.py:0
msgid "A contract has to be started from its quotation: open the quotation and click 'Request Contract Approval'."
msgstr "合同必须从报价单发起：请打开报价单，点击“发起合同审批”。"

#. module: aiis_customer_contract
#. odoo-python
#: code:addons/aiis_customer_contract/models/customer_contract.py:0
msgid "Enter the customer's PO number before submitting."
msgstr "提交前请填写客户 PO 号。"

#. module: aiis_customer_contract
#. odoo-python
#: code:addons/aiis_customer_contract/models/customer_contract.py:0
msgid "Attach the customer's PO before submitting."
msgstr "提交前请上传客户 PO 原件。"

#. module: aiis_customer_contract
#. odoo-python
#: code:addons/aiis_customer_contract/models/customer_contract.py:0
msgid "The quotation was changed after this contract was submitted (%(old)s → %(new)s). Reset the contract to draft and submit it again."
msgstr "合同提交后报价单已被修改（%(old)s → %(new)s）。请将合同退回草稿后重新提交审批。"

#. module: aiis_customer_contract
#. odoo-python
#: code:addons/aiis_customer_contract/models/sale_order.py:0
msgid "%s cannot be confirmed yet: it needs an approved customer contract first. Use 'Request Contract Approval' on the quotation."
msgstr "%s 暂时不能确认：需要先通过客户合同审批。请在报价单上点击“发起合同审批”。"

#. module: aiis_customer_contract
#. odoo-python
#: code:addons/aiis_customer_contract/models/sale_order.py:0
msgid "%(so)s was changed after its contract was approved (%(old)s → %(new)s). Reset contract %(ct)s to draft and submit it again."
msgstr "%(so)s 在合同批准后被修改过（%(old)s → %(new)s）。请将合同 %(ct)s 退回草稿后重新提交审批。"
