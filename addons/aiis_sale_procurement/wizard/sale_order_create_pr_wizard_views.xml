<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_create_pr_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.create.pr.wizard.form</field>
        <field name="model">sale.order.create.pr.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Request">
                <p class="text-muted">
                    Tick the lines that need to be bought in. Quantities default to what is
                    not yet covered by earlier purchase requests or purchase orders.
                    The request goes to your manager for approval as usual.
                </p>
                <group>
                    <group>
                        <field name="sale_order_id" options="{'no_open': True}"/>
                        <field name="needed_by_date"/>
                    </group>
                </group>
                <field name="reason" placeholder="Why do we need this?"/>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="sale_line_id" column_invisible="1"/>
                        <field name="product_id"/>
                        <field name="description"/>
                        <field name="sold_qty"/>
                        <field name="covered_qty"/>
                        <field name="remaining_qty"/>
                        <field name="quantity" readonly="not selected"/>
                        <field name="uom_id"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="estimated_unit_price" readonly="not selected"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" string="Create Purchase Request" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
