<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_procurement" model="ir.ui.view">
        <field name="name">sale.order.form.procurement.request</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_quotation_send'][last()]" position="after">
                <button name="action_create_procurement_request" string="Create Purchase Request"
                        type="object" invisible="state != 'sale'"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_procurement_requests" type="object" class="oe_stat_button"
                        icon="fa-shopping-basket" invisible="procurement_request_count == 0">
                    <field name="procurement_request_count" widget="statinfo" string="Purchase Requests"/>
                </button>
            </div>
            <xpath expr="//field[@name='order_line']/tree/field[@name='qty_invoiced']" position="after">
                <field name="purchase_covered_qty" string="Purchased"
                       column_invisible="parent.state != 'sale'" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
