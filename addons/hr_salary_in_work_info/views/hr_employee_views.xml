<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_salary_in_work_info" model="ir.ui.view">
        <field name="name">hr.employee.form.salary.in.work.info</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='public']//div[@id='o_work_employee_main']" position="inside">
                <group string="Salary" name="salary" groups="hr_contract.group_hr_contract_manager">
                    <field name="current_wage" widget="monetary"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
