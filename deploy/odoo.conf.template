; Generated by deploy/render_conf.sh from deploy/odoo.conf.template.
; Do not edit deploy/odoo.conf by hand and never commit it.
[options]
addons_path = /mnt/extra-addons,/mnt/extra-addons/oca,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo
admin_passwd = ${ODOO_ADMIN_PASSWD}
db_host = db
db_port = 5432
db_user = odoo
db_password = ${DB_PASSWORD}
; No db_name: Odoo would create the database on first start, before
; deploy/first_install.sh. dbfilter alone picks the one database.
dbfilter = ^${DB_NAME}$
list_db = False
proxy_mode = True
without_demo = all

; Multi-process: sized for 4 vCPU / 16 GB, about 70 users
workers = 4
max_cron_threads = 1
gevent_port = 8072
db_maxconn = 32
limit_memory_soft = 2147483648
limit_memory_hard = 2684354560
limit_time_cpu = 600
limit_time_real = 1200
limit_request = 8192

; Outgoing mail: fill in once the company's mail system is chosen
; (plan section 2, item 3), then configure it in Settings > Technical >
; Outgoing Mail Servers instead if it needs OAuth (Microsoft 365 / Google).
email_from = ${MAIL_FROM}
