# MHTT production server. Copy to deploy/.env on the server (never commit
# it), fill in, then: deploy/render_conf.sh
DB_NAME=mhtt
# Plan section 2, item 2
ODOO_DOMAIN=CHANGE_ME.example.com
# Long random strings: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME
ODOO_ADMIN_PASSWD=CHANGE_ME
# Sender of system e-mails (plan section 2, item 3)
MAIL_FROM=CHANGE_ME@example.com
